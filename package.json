{
  "name": "lavish-tracker",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs dev",
    "build": "vinext build",
    "start": "node scripts/run-local.mjs start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/*.test.mjs",
    "test:backup-ui": "LAVISH_BACKUP_UI_TEST=1 node --test tests/backup-ui.test.mjs tests/library-refresh-ui.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.0",
    "puppeteer-core": "^25.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261009.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
